{
  "name": "bioar-offline",
  "version": "1.0.0",
  "private": true,
  "description": "BioAR — Atlas de Anatomia 3D educacional, empacotado para Android e funcionamento offline.",
  "scripts": {
    "dev": "npm run copy:vendor && vite --host 0.0.0.0",
    "copy:vendor": "node scripts/copy-vendor.mjs",
    "build": "npm run copy:vendor && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@fontsource/nunito": "5.3.0",
    "@phosphor-icons/web": "2.1.2",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "vite": "8.3.8"
  }
}
